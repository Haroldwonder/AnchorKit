{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnchorKit Configuration Schema",
  "type": "object",
  "required": ["contract", "attestors", "sessions"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["name", "version", "network"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {
          "type": "string",
          "maxLength": 256
        },
        "network": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "enum": ["stellar-testnet", "stellar-mainnet", "stellar-futurenet"]
        }
      },
      "additionalProperties": false
    },
    "attestors": {
      "type": "object",
      "required": ["registry"],
      "properties": {
        "registry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["name", "address", "endpoint", "role", "enabled"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9-]+$"
              },
              "address": {
                "type": "string",
                "minLength": 54,
                "maxLength": 56,
                "pattern": "^G[A-Z0-9]{55}$"
              },
              "description": {
                "type": "string",
                "maxLength": 256
              },
              "endpoint": {
                "type": "string",
                "minLength": 10,
                "maxLength": 256,
                "pattern": "^https://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(/.*)?$"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "enum": ["kyc-issuer", "transfer-verifier", "compliance-approver", "rate-provider", "attestor"]
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "required": ["enable_session_tracking", "session_timeout_seconds", "operations_per_session", "audit_log_retention_days"],
      "properties": {
        "enable_session_tracking": {
          "type": "boolean"
        },
        "session_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "operations_per_session": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "audit_log_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["admin_key", "rpc_endpoint", "network"],
      "properties": {
        "admin_key": {
          "type": "string",
          "description": "Stellar public key of the contract admin (G…, 56 chars)",
          "pattern": "^G[A-Z0-9]{55}$",
          "minLength": 56,
          "maxLength": 56
        },
        "rpc_endpoint": {
          "type": "string",
          "description": "Soroban RPC endpoint URL (HTTPS required)",
          "minLength": 10,
          "maxLength": 2048,
          "pattern": "^https://.+"
        },
        "network": {
          "type": "string",
          "description": "Stellar network this deployment targets",
          "enum": ["stellar-testnet", "stellar-mainnet", "stellar-futurenet"]
        },
        "contract_id": {
          "type": "string",
          "description": "Deployed Soroban contract address (C…, 56 chars) — added after deployment",
          "pattern": "^C[A-Z2-7]{55}$",
          "minLength": 56,
          "maxLength": 56
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "stellarAddress": {
      "type": "string",
      "pattern": "^G[A-Z0-9]{55}$",
      "minLength": 56,
      "maxLength": 56
    },
    "sorobanContractId": {
      "type": "string",
      "pattern": "^C[A-Z2-7]{55}$",
      "minLength": 56,
      "maxLength": 56
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2048,
      "pattern": "^https://[a-zA-Z0-9][a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(:[0-9]+)?(/.*)?$"
    }
  }
}
